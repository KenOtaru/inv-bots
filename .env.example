# Binance Options: never commit the filled-in .env file.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_OPTIONS_PAPER_MODE=true
BINANCE_OPTIONS_UNDERLYINGS=BTCUSDT,ETHUSDT
BINANCE_OPTIONS_MAX_PREMIUM_USDT=10
BINANCE_OPTIONS_MAX_DAILY_LOSS_USDT=25
# Leave these defaults unchanged unless Binance gives you an approved endpoint.
BINANCE_OPTIONS_BASE_URL=https://eapi.binance.com
BINANCE_SPOT_BASE_URL=https://api.binance.com
