# ==================== TRADING PARAMETERS ====================

# Initial stake in USD
INITIAL_STAKE=10.50

# Martingale multiplier after loss
MULTIPLIER=11.3

# Stop trading after X consecutive losses
MAX_CONSECUTIVE_LOSSES=3

# Stop trading after losing $X
STOP_LOSS=70

# Stop trading after gaining $X
TAKE_PROFIT=20

# Minimum ensemble confidence to place trade (50-95)
MIN_CONFIDENCE=1

# Minimum number of AI models that must agree
MIN_MODELS_AGREEMENT=1

# Ticks of history required before first trade
REQUIRED_HISTORY_LENGTH=500

# ==================== TIMING ====================

# Minimum wait time between trades (milliseconds)
MIN_WAIT_TIME=30000

# Maximum wait time between trades (milliseconds)
MAX_WAIT_TIME=120000

