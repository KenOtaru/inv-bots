# ==================== TRADING PARAMETERS ====================

# Starting investment capital (default: 100)
INVESTMENT_CAPITAL=100

# Kelly Fraction - Controls position sizing aggressiveness
# 0.25 = Quarter Kelly (conservative, recommended)
# 0.50 = Half Kelly (moderate)
# 1.00 = Full Kelly (aggressive, NOT recommended)
KELLY_FRACTION=0.25

# Maximum drawdown before stopping (percentage, default: 20)
MAX_DRAWDOWN_PERCENT=20
# Maximum position size per trade (percentage of capital, default: 5)
MAX_POSITION_PERCENT=5
# Minimum position size per trade (percentage of capital, default: 0.5)
MIN_POSITION_PERCENT=0.5
# Daily loss limit (percentage of capital, default: 10)
DAILY_LOSS_LIMIT=10
# Base payout for Digit Differ trades (default: 0.90 = 90%)
BASE_PAYOUT=0.90


# Initial stake in USD
INITIAL_STAKE=0.61

# Maximum stake as percentage of capital (default: 5%)
MAX_STAKE_PERCENT=5

# Martingale multiplier after loss
MULTIPLIER=11.3

# Stop trading after X consecutive losses
MAX_CONSECUTIVE_LOSSES=6

# Daily loss limit in dollars (default: 50)
DAILY_LOSS_LIMIT=50

# Stop loss percentage of initial capital (default: 20)
STOP_LOSS_PERCENT=20

# Daily profit target in dollars (default: 100)
DAILY_PROFIT_TARGET=100

# Take profit percentage of initial capital (default: 50)
TAKE_PROFIT_PERCENT=50

# Stop trading after losing $X
STOP_LOSS=70

# Stop trading after gaining $X
TAKE_PROFIT=1000

# Minimum ensemble confidence to place trade (50-95)
MIN_CONFIDENCE=1

# Minimum number of AI models that must agree
MIN_MODELS_AGREEMENT=2

# Ticks of history required before first trade
REQUIRED_HISTORY_LENGTH=500

# ==================== TIMING ====================

# Minimum wait time between trades (milliseconds)
MIN_WAIT_TIME=200000

# Maximum wait time between trades (milliseconds)
MAX_WAIT_TIME=900000

# ==================== ASSETS ====================

# Comma-separated list of assets to trade
# Available: R_10, R_25, R_50, R_75, R_100, RDBULL, RDBEAR
ASSETS=R_10, R_25, R_50, R_75, R_100, RDBULL, RDBEAR

# ==================== KO DIffer Bot ====================
TRADESYS=1
TRADESYS2=2

