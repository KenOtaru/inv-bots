# Deriv Personal Access Token (required)
# Create one at https://app.deriv.com/account/api-token
# Required scopes: Read, Trade, Trading Information, Payments
# You can reuse the same token as kairos-trade.
DERIV_TOKEN=pat_8e0a3285bd6e74f52a67985b8069f4bea42aa96ce65d129c60ebb838ed1065ee
DERIV_TOKEN2=pat_cb2016855b5e6c61ac95f94432192dd6ed86bec7f7454e575d3fe1ed9f617692

# Deriv App ID (optional — bundled default is used if blank)
DERIV_APP_ID=33uslPtthXBEkQOdfKfoY
DERIV_APP_ID2=33uslPtthXBEkQOdfKfoY

# Pin a specific account (e.g. VRTC12345678). Blank = pick first active demo.
DERIV_ACCOUNT_ID=
DERIV_ACCOUNT_ID2=

# Prefer 'demo' or 'real' when the token has both. Default: demo.
HILO_PREFER=demo
HILO_PREFER2=demo

# Market defaults (CLI flags override these)
# 1HZ100V | 1HZ50V
HILO_SYMBOL=1HZ50V
HILO_SYMBOL2=1HZ50V
HILO_STAKE=0.5
HILO_STAKE2=0.5
HILO_CURRENCY=
HILO_CURRENCY2=


# Block grid
HILO_BLOCK_MINUTES=3
HILO_BLOCK_MINUTES2=3
HILO_BLOCK_TP=1.5
HILO_BLOCK_TP2=1.5

# Trade primitive: 'higher-lower' (breakout bet) or 'no-touch' (stay-in-range bet)
HILO_TRADE_MODE=no-touch
HILO_TRADE_MODE2=no-touch

# Trade direction: 'both' (open upper + lower, default) or 'positive-ev' (only open legs with positive EV)
HILO_TRADE_DIRECTION=positive-ev
HILO_TRADE_DIRECTION2=both

# Martingale stake sizing (OFF by default) — increases stake after losses
# Set to 1 or true to enable. Stakes reset after a winning block.
HILO_MARTINGALE_ENABLED=true
HILO_MARTINGALE_ENABLED2=false
HILO_MARTINGALE_MULTIPLIER=2
HILO_MARTINGALE_MULTIPLIER2=2
HILO_MARTINGALE_STEPS=9
HILO_MARTINGALE_STEPS2=9

# Circuit breakers — halt the bot when these thresholds are hit
HILO_SESSION_TP=1500
HILO_SESSION_TP2=1500
HILO_SESSION_SL=500
HILO_SESSION_SL2=500
HILO_MAX_LOSSES=50
HILO_MAX_LOSSES2=100
HILO_DAILY_LOSS_CAP=200
HILO_DAILY_LOSS_CAP2=200

# Prediction (port of TimeBlocks.mq5)
HILO_RANGE_MODE=hybrid
HILO_RANGE_MODE2=hybrid
HILO_LOOKBACK_DAYS=20
HILO_LOOKBACK_DAYS2=20
HILO_ATR_BARS=14
HILO_ATR_BARS2=14
HILO_RANGE_K=1.0
HILO_RANGE_K2=1.0

# EV-first band selection (Phase 1) — ON by default; the edge-harvesting core
HILO_EV_MODE=true
HILO_EV_MODE2=true
HILO_K_CANDIDATES=1,1.5,2,2.5,3
HILO_K_CANDIDATES2=1,1.5,2,2.5,3
# minEv	Expected trade frequency	When to use
# 0.05	Very high (many blocks)	If you want maximum activity and can tolerate more losses
# 0.10	High	Default starting point
# 0.15	Moderate	Recommended start
# 0.20	Low	If 0.15 is still too many losing trades
HILO_MIN_EV=0.05
HILO_MIN_EV2=0.05
HILO_EV_STAGGER=false
HILO_EV_STAGGER2=true

# Volatility regime detection (Phase 4) — blend recent realized vol into the
# same-TOD model mean. 0 = off, 0.2 = recommended for live (keeps model honest
# during vol spikes without chasing noise), 1 = recent vol alone.
HILO_REGIME_BARS=24
HILO_REGIME_BARS2=24
HILO_REGIME_BLEND=0.2
HILO_REGIME_BLEND2=0.2

# Telegram notifications (optional — both required to enable)
# Create a bot at https://t.me/BotFather, then get your chat ID from https://t.me/chatid_echo_bot
TELEGRAM_BOT_TOKEN=8578702717:AAFShpdLRtat7PHqjZMUqhY4UNKlWyaGtmo
TELEGRAM_BOT_TOKEN2=8578702717:AAFShpdLRtat7PHqjZMUqhY4UNKlWyaGtmo
TELEGRAM_CHAT_ID=752497117
TELEGRAM_CHAT_ID2=752497117

# Path to store the bot's state (optional — defaults to .hilo_state.json)
HILO_STATE_PATH=.hilo_state_02.json
HILO_STATE_PATH2=.hilo2_state_01.json